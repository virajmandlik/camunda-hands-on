  <decision id="deliveryFeeDecision" name="deliveryFeeDecision">
    <decisionTable id="DecisionTable_1dzyn68">
      <input id="Input_1" label="orderAmount">
        <inputExpression id="InputExpression_1" typeRef="number">
          <text>orderAmount</text>
        </inputExpression>
      </input>
      <output id="Output_1" label="deliveryFee" name="deliveryFee" typeRef="number" />
      <rule id="DecisionRule_01k5qt1">
        <inputEntry id="UnaryTests_0xw35d9">
          <text>&lt;500</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_1kfupq0">
          <text>40</text>
        </outputEntry>
      </rule>
      <rule id="DecisionRule_1krdfxx">
        <inputEntry id="UnaryTests_0aqg8wk">
          <text>&gt;=500</text>
        </inputEntry>
        <outputEntry id="LiteralExpression_06gyoqu">
          <text>0</text>
        </outputEntry>
      </rule>
    </decisionTable>
  </decision>
  <dmndi:DMNDI>
